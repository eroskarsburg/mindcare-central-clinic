# ---------------------------------------------------------------------------
# MindCare — variáveis de ambiente
# Copie para ".env" e ajuste os valores. O arquivo .env NÃO é versionado.
# É lido tanto pelo docker compose quanto pelo `dotnet run` (via DotNetEnv).
# ---------------------------------------------------------------------------

# Ambiente do ASP.NET Core (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Porta HTTP exposta pela aplicação no docker compose
APP_PORT=8080

# --- Banco de dados (MySQL) -------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mindcare_db
MYSQL_USER=mindcare
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# String de conexão usada pela aplicação.
# Em docker compose ela é montada automaticamente a partir das variáveis acima.
ConnectionStrings__MindCare=Server=localhost;Port=3306;Database=mindcare_db;User ID=mindcare;Password=change-me;

# --- Administrador inicial ---------------------------------------------------
# Criado automaticamente na inicialização caso ainda não exista nenhum administrador.
Seed__AdminUsername=admin
Seed__AdminPassword=Admin@123

# Popula a base vazia com pacientes e consultas fictícios (true/false).
# Sem definir: ligado em Development (appsettings.Development.json) e desligado nos demais ambientes.
# Seed__DemoData=true

# --- Segurança ---------------------------------------------------------------
# Tentativas de login erradas antes do bloqueio temporário e duração do bloqueio.
# Security__MaxFailedLoginAttempts=5
# Security__LockoutMinutes=15

# --- Teleconsulta ------------------------------------------------------------
# Servidor de videochamada usado para gerar as salas (Jitsi público por padrão).
# Teleconsult__BaseUrl=https://meet.jit.si

# --- Notificações ao paciente -------------------------------------------------
# Endereço público usado nos links de confirmação enviados ao paciente.
Notifications__PublicBaseUrl=http://localhost:8080
# Notifications__ReminderHoursBefore=24

# WhatsApp Cloud API (Meta) — veja docs/whatsapp.md
# Disabled | Simulated | Live
WhatsApp__Mode=Disabled
WhatsApp__PhoneNumberId=
WhatsApp__AccessToken=
WhatsApp__AppSecret=
WhatsApp__VerifyToken=

# E-mail (SMTP)
Email__Enabled=false
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=nao-responda@suaclinica.com.br
Email__FromName=MindCare

# --- Identidade da clínica (exibida na interface) ---------------------------
Clinic__Name=MindCare
Clinic__Tagline=Cuidado que acolhe
