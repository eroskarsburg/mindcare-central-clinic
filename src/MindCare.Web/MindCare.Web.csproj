<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MindCare.Web</RootNamespace>
    <UserSecretsId>mindcare-central-clinic</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindCare.Application\MindCare.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;package-lock.json;scripts/**" />
  </ItemGroup>

  <!--
    Bibliotecas front-end (Bootstrap, Bootstrap Icons, DataTables) são gerenciadas via npm
    e copiadas para wwwroot/lib. O Dependabot mantém o package.json atualizado.
    Use -p:SkipClientLibraries=true quando as bibliotecas já tiverem sido restauradas (ex.: Docker).
  -->
  <Target Name="RestoreClientLibraries" BeforeTargets="BeforeBuild" Condition="'$(SkipClientLibraries)' != 'true' And !Exists('wwwroot/lib/.restored')">
    <Message Importance="high" Text="Restaurando bibliotecas front-end (npm)..." />
    <Exec Command="npm ci --no-audit --no-fund" Condition="!Exists('node_modules')" />
    <Exec Command="npm run vendor" />
  </Target>

</Project>
