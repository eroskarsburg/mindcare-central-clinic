@model IReadOnlyList<Professional>
@{
    ViewData["Title"] = "Profissionais";
}

<section data-crud data-endpoint="/Professional" data-modal="#professionalModal">
    <header class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-person-badge"></i> Equipe</span>
            <h1>Profissionais</h1>
            <p>Cada profissional recebe automaticamente um usuário de acesso.</p>
        </div>
        <button class="btn btn-primary" type="button" data-crud-create><i class="bi bi-plus-lg me-1"></i> Novo profissional</button>
    </header>

    <div class="mc-card mc-card-body pt-4">
        <table class="table table-hover" data-table>
            <thead>
                <tr>
                    <th>Profissional</th>
                    <th>CPF</th>
                    <th>Especialidade</th>
                    <th>Repasse</th>
                    <th>Login</th>
                    <th class="no-sort table-actions"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <span class="cell-title">@p.Name</span>
                            <span class="cell-sub">@p.Gender</span>
                        </td>
                        <td class="font-monospace small">@Cpf.Format(p.Cpf)</td>
                        <td>
                            <span class="badge-soft neutral">@p.Speciality</span>
                            @if (!string.IsNullOrEmpty(p.RegistrationNumber))
                            {
                                <span class="cell-sub">@p.RegistrationNumber</span>
                            }
                        </td>
                        <td data-order="@p.CommissionPercent">@((p.CommissionPercent / 100m).ToString("P0"))</td>
                        <td class="small">@p.User?.Username</td>
                        <td class="table-actions">
                            <button class="btn-icon" type="button" title="Editar" aria-label="Editar @p.Name"
                                    data-crud-edit data-item="@Html.ToDataJson(new { p.Id, p.Name, p.Cpf, p.Gender, p.Speciality, p.RegistrationNumber, p.CommissionPercent })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn-icon danger" type="button" title="Excluir" aria-label="Excluir @p.Name"
                                    data-crud-delete data-id="@p.Id" data-name="@p.Name (e o usuário de acesso)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade" id="professionalModal" tabindex="-1" aria-labelledby="professionalModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title" id="professionalModalTitle" data-title-create="Novo profissional" data-title-edit="Editar profissional">Novo profissional</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="professional-name">Nome completo</label>
                    <input class="form-control" id="professional-name" name="name" maxlength="100" required />
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="professional-cpf">CPF</label>
                        <input class="form-control" id="professional-cpf" name="cpf" data-mask="cpf" inputmode="numeric" placeholder="000.000.000-00" required />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="professional-gender">Gênero</label>
                        <select class="form-select" id="professional-gender" name="gender" required>
                            @foreach (var g in Genders.All)
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label" for="professional-speciality">Especialidade</label>
                    <input class="form-control" id="professional-speciality" name="speciality" maxlength="60" list="specialities" placeholder="Ex.: Psicoterapia" required />
                    <datalist id="specialities">
                        <option value="Psicoterapia"></option>
                        <option value="Psiquiatria"></option>
                        <option value="Terapia cognitivo-comportamental"></option>
                        <option value="Psicologia infantil"></option>
                        <option value="Neuropsicologia"></option>
                    </datalist>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-sm-7">
                        <label class="form-label" for="professional-registration">Registro profissional</label>
                        <input class="form-control" id="professional-registration" name="registrationNumber" maxlength="40" placeholder="Ex.: CRP 07/12345" />
                        <small class="text-muted-mc">Impresso nos recibos.</small>
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label" for="professional-commission">Repasse</label>
                        <div class="input-group">
                            <input class="form-control" id="professional-commission" name="commissionPercent" type="number" min="0" max="100" step="0.5" value="0" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="alert alert-light border small mt-3 mb-0" data-create-only>
                    <i class="bi bi-key me-1"></i>
                    O login será o CPF. Uma senha temporária aleatória será exibida após salvar e deverá ser trocada no primeiro acesso.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>
