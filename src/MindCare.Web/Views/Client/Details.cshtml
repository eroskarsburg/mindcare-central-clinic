@model ClientDetailsViewModel
@using MindCare.Web.Controllers
@using MindCare.Application.Finance
@{
    var d = Model.Details;
    var c = d.Client;
    ViewData["Title"] = c.Name;
    var today = DateTime.Today;
    var age = c.AgeOn(today);
    var pastSessions = d.Appointments.Where(a => a.ScheduledAt <= DateTime.Now && a.Status != AppointmentStatus.Cancelada).Take(30).ToList();
    var notes = Model.Notes;
    var statusTone = c.Status switch { ClientStatus.Ativo => "success", ClientStatus.EmPausa => "warning", _ => "muted" };
    var initials = string.Concat(c.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant();
}

<header class="page-header">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-lg">@initials</span>
        <div>
            <a class="eyebrow text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left"></i> Pacientes</a>
            <h1>@c.Name</h1>
            <p class="d-flex flex-wrap gap-2 align-items-center">
                @if (c.IsAnonymized)
                {
                    <span class="badge-soft slate"><i class="bi bi-incognito"></i>Anonimizado</span>
                }
                else
                {
                    <span class="badge-soft @statusTone">@(c.Status == ClientStatus.EmPausa ? "Em pausa" : c.Status.ToString())</span>
                }
                @if (age is not null)
                {
                    <span>@age anos</span>
                }
                @if (!string.IsNullOrEmpty(c.HealthInsurance))
                {
                    <span>· @c.HealthInsurance</span>
                }
                @if (c.ResponsibleProfessional is not null)
                {
                    <span>· Referência: <strong>@c.ResponsibleProfessional.Name</strong></span>
                }
            </p>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (!string.IsNullOrEmpty(c.Phone))
        {
            <a class="btn btn-soft" href="https://wa.me/@c.Phone" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-1"></i> Conversar</a>
        }
        <a class="btn btn-primary" asp-controller="Appointment" asp-action="Index"><i class="bi bi-calendar-plus me-1"></i> Agendar</a>
    </div>
</header>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="mc-card kpi tone-sage">
            <div class="kpi-icon"><i class="bi bi-check-all"></i></div>
            <div class="kpi-value">@d.SessionsDone</div>
            <div class="kpi-label">Sessões realizadas@(d.FirstSession is { } first ? $" desde {first:MM/yyyy}" : null)</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="mc-card kpi tone-blush">
            <div class="kpi-icon"><i class="bi bi-person-x"></i></div>
            <div class="kpi-value">@d.NoShows</div>
            <div class="kpi-label">Faltas · @d.Cancelled @(d.Cancelled == 1 ? "cancelamento" : "cancelamentos")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="mc-card kpi tone-taupe">
            <div class="kpi-icon"><i class="bi bi-wallet2"></i></div>
            <div class="kpi-value">@d.Outstanding.ToString("C0")</div>
            <div class="kpi-label">Em aberto · @d.TotalPaid.ToString("C0") pagos</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="mc-card kpi tone-slate">
            <div class="kpi-icon"><i class="bi bi-calendar-event"></i></div>
            <div class="kpi-value fs-5 mt-2">@(d.NextAppointment?.ScheduledAt.ToString("dd/MM · HH:mm") ?? "—")</div>
            <div class="kpi-label">Próxima sessão@(d.NextAppointment?.Professional is { } np ? $" com {np.Name.Split(' ')[0]}" : null)</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <aside class="col-xl-4">
        <div class="mc-card mc-card-body pt-4">
            <h2 class="h5 mb-3">Cadastro</h2>
            <dl class="info-list">
                <div><dt>CPF</dt><dd class="font-monospace">@Cpf.Format(c.Cpf)</dd></div>
                <div><dt>Nascimento</dt><dd>@(c.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                <div><dt>Gênero</dt><dd>@c.Gender</dd></div>
                <div><dt>Celular</dt><dd>@(string.IsNullOrEmpty(c.Phone) ? "—" : Phone.Format(c.Phone))</dd></div>
                <div><dt>E-mail</dt><dd class="text-break">@(c.Email ?? "—")</dd></div>
                <div><dt>Endereço</dt><dd>@(c.Address ?? "—")</dd></div>
                <div>
                    <dt>Avisos</dt>
                    <dd>
                        <i class="bi bi-whatsapp @(c.NotifyByWhatsApp ? "text-success" : "text-muted-mc")" title="WhatsApp"></i>
                        <i class="bi bi-envelope ms-2 @(c.NotifyByEmail ? "text-success" : "text-muted-mc")" title="E-mail"></i>
                    </dd>
                </div>
                <div><dt>LGPD</dt><dd>@(c.ConsentAt is { } consent ? $"Termo em {consent:dd/MM/yyyy}" : "Sem termo")</dd></div>
            </dl>

            @if (!string.IsNullOrEmpty(c.EmergencyContactName) || !string.IsNullOrEmpty(c.EmergencyContactPhone))
            {
                <div class="emergency mt-3">
                    <i class="bi bi-telephone-plus"></i>
                    <div>
                        <small class="text-muted-mc d-block">Contato de emergência</small>
                        <strong>@c.EmergencyContactName</strong>
                        @if (!string.IsNullOrEmpty(c.EmergencyContactPhone))
                        {
                            <span class="d-block small">@Phone.Format(c.EmergencyContactPhone)</span>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(c.Notes))
            {
                <div class="mt-3 small p-3 rounded-3" style="background: var(--mc-surface-muted); white-space: pre-line">@c.Notes</div>
            }
        </div>
    </aside>

    <div class="col-xl-8">
        <ul class="nav nav-pills segmented d-inline-flex mb-3 flex-wrap" role="tablist">
            <li class="nav-item" role="presentation"><button class="btn active" data-bs-toggle="tab" data-bs-target="#tab-notes" type="button" role="tab"><i class="bi bi-journal-medical me-1"></i> Evolução</button></li>
            <li class="nav-item" role="presentation"><button class="btn" data-bs-toggle="tab" data-bs-target="#tab-sessions" type="button" role="tab"><i class="bi bi-calendar3 me-1"></i> Consultas <span class="badge-soft neutral ms-1">@d.Appointments.Count</span></button></li>
            <li class="nav-item" role="presentation"><button class="btn" data-bs-toggle="tab" data-bs-target="#tab-finance" type="button" role="tab"><i class="bi bi-wallet2 me-1"></i> Financeiro</button></li>
            <li class="nav-item" role="presentation"><button class="btn" data-bs-toggle="tab" data-bs-target="#tab-docs" type="button" role="tab"><i class="bi bi-paperclip me-1"></i> Documentos <span class="badge-soft neutral ms-1">@Model.Documents.Count</span></button></li>
        </ul>

        <div class="tab-content">
            @* ---------------- Evolução (prontuário) ---------------- *@
            <div class="tab-pane fade show active" id="tab-notes" role="tabpanel">
                @if (notes.CanWrite && !c.IsAnonymized)
                {
                    <form class="mc-card mc-card-body pt-4 mb-3" data-api-form data-method="POST" data-reload action="/Record/CreateNote" autocomplete="off">
                        <input type="hidden" name="clientId" value="@c.Id" />
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <label class="form-label m-0" for="note-content"><i class="bi bi-lock me-1"></i>Nova evolução</label>
                            <select class="form-select form-select-sm w-auto" name="appointmentId" aria-label="Sessão">
                                <option value="">Sem sessão vinculada</option>
                                @foreach (var a in pastSessions)
                                {
                                    <option value="@a.Id">Sessão de @a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</option>
                                }
                            </select>
                        </div>
                        <textarea class="form-control" id="note-content" name="content" rows="4" maxlength="20000" required
                                  placeholder="Demanda, intervenções, observações e encaminhamentos da sessão..."></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted-mc"><i class="bi bi-shield-lock me-1"></i>Criptografado. Visível só para você e para o profissional de referência.</small>
                            <button class="btn btn-primary btn-sm" type="submit">Registrar</button>
                        </div>
                    </form>
                }
                else if (!notes.CanWrite)
                {
                    <div class="alert alert-light border d-flex gap-2 align-items-start">
                        <i class="bi bi-shield-lock fs-5"></i>
                        <div>O prontuário é sigiloso: somente o profissional que registrou e o profissional de referência do paciente têm acesso ao conteúdo.</div>
                    </div>
                }

                @if (notes.Notes.Count == 0 && notes.HiddenCount == 0)
                {
                    <div class="mc-card"><div class="empty-state"><i class="bi bi-journal"></i>Nenhuma evolução registrada.</div></div>
                }

                <div class="timeline">
                    @foreach (var n in notes.Notes)
                    {
                        <article class="mc-card note-card">
                            <header class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <strong>@(n.AppointmentAt?.ToString("dd/MM/yyyy") ?? n.CreatedAt.ToString("dd/MM/yyyy"))</strong>
                                    <span class="text-muted-mc small">
                                        · @n.ProfessionalName
                                        @if (n.AppointmentAt is not null)
                                        {
                                            <span> · sessão das @n.AppointmentAt.Value.ToString("HH:mm")</span>
                                        }
                                        @if (n.UpdatedAt is not null)
                                        {
                                            <span title="Editada em @n.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")"> · editada</span>
                                        }
                                    </span>
                                </div>
                                @if (n.IsAuthor)
                                {
                                    <div class="d-flex">
                                        <button class="btn-icon" type="button" title="Editar" data-note-edit="@n.Id" data-note-content="@n.Content"><i class="bi bi-pencil"></i></button>
                                        <button class="btn-icon danger" type="button" title="Excluir"
                                                data-api-action="/Record/DeleteNote/@n.Id" data-method="DELETE" data-confirm="Excluir esta evolução do prontuário?" data-confirm-text="Excluir">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                }
                            </header>
                            <div class="note-content">@n.Content</div>
                        </article>
                    }
                </div>

                @if (notes.HiddenCount > 0)
                {
                    <p class="small text-muted-mc mt-3"><i class="bi bi-eye-slash me-1"></i>@notes.HiddenCount @(notes.HiddenCount == 1 ? "evolução registrada por outro profissional não é exibida" : "evoluções registradas por outros profissionais não são exibidas") (sigilo).</p>
                }
            </div>

            @* ---------------- Consultas ---------------- *@
            <div class="tab-pane fade" id="tab-sessions" role="tabpanel">
                <div class="mc-card mc-card-body pt-4">
                    <table class="table table-hover" data-table>
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Profissional</th>
                                <th>Status</th>
                                <th>Valor</th>
                                <th>Pagamento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in d.Appointments)
                            {
                                var p = a.Payment ?? new Payment();
                                <tr class="@(a.Status == AppointmentStatus.Cancelada ? "opacity-50" : null)">
                                    <td data-order="@a.ScheduledAt.ToString("yyyyMMddHHmm")">
                                        <span class="cell-title">@a.ScheduledAt.ToString("dd/MM/yyyy")</span>
                                        <span class="cell-sub"><i class="bi @a.Modality.ModalityIcon() me-1"></i>@a.ScheduledAt.ToString("ddd HH:mm")</span>
                                    </td>
                                    <td>@(a.Professional?.Name ?? "—")</td>
                                    <td><partial name="_AppointmentStatus" model="a.Status" /></td>
                                    <td data-order="@p.Price">@p.Price.ToString("C")</td>
                                    <td>
                                        <partial name="_PaymentStatus" model="p.Status" />
                                        @if (p.PaidPrice > 0 && p.Status != PaymentStatus.Confirmado)
                                        {
                                            <span class="cell-sub">@p.PaidPrice.ToString("C") pagos</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ---------------- Financeiro: pacotes e recibos ---------------- *@
            <div class="tab-pane fade" id="tab-finance" role="tabpanel">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <form class="mc-card mc-card-body pt-4 h-100" method="get" asp-controller="Report" asp-action="MonthlyReceipt">
                            <input type="hidden" name="clientId" value="@c.Id" />
                            <h2 class="h6"><i class="bi bi-file-earmark-pdf me-1"></i>Recibo mensal (IR)</h2>
                            <p class="small text-muted-mc">Consolida tudo o que foi pago no mês, com valor por extenso e dados do profissional.</p>
                            <div class="d-flex gap-2">
                                <input class="form-control" type="month" name="month" value="@DateTime.Today.ToString("yyyy-MM")" max="@DateTime.Today.ToString("yyyy-MM")" required aria-label="Mês" />
                                <button class="btn btn-primary text-nowrap" type="submit">Gerar PDF</button>
                            </div>
                        </form>
                    </div>
                    @if (!c.IsAnonymized)
                    {
                        <div class="col-md-6">
                            <form class="mc-card mc-card-body pt-4 h-100" data-api-form data-method="POST" data-reload action="/Package/Create" autocomplete="off">
                                <input type="hidden" name="clientId" value="@c.Id" />
                                <h2 class="h6"><i class="bi bi-box2-heart me-1"></i>Novo pacote de sessões</h2>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <input class="form-control form-control-sm" name="name" maxlength="80" required value="Pacote mensal" aria-label="Nome do pacote" />
                                    </div>
                                    <div class="col-4">
                                        <div class="input-group input-group-sm">
                                            <input class="form-control" name="totalSessions" type="number" min="1" max="100" value="4" required aria-label="Sessões" />
                                            <span class="input-group-text">sessões</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">R$</span>
                                            <input class="form-control" name="price" type="number" min="0" step="0.01" required aria-label="Valor" />
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <input class="form-control form-control-sm" name="expiresAt" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" title="Validade (opcional)" aria-label="Validade" />
                                    </div>
                                </div>
                                <div class="text-end mt-2"><button class="btn btn-soft btn-sm" type="submit">Criar pacote</button></div>
                            </form>
                        </div>
                    }
                </div>

                <div class="mc-card mc-card-body pt-4">
                    <h2 class="h6 mb-3">Pacotes</h2>
                    @if (Model.Packages.Count == 0)
                    {
                        <div class="empty-state py-3"><i class="bi bi-box2"></i>Nenhum pacote. Ao agendar, marque “Usar pacote” para consumir as sessões.</div>
                    }
                    @foreach (var pkg in Model.Packages)
                    {
                        var used = pkg.UsedSessions;
                        var paidPct = pkg.Price == 0 ? 100 : (int)(pkg.PaidAmount / pkg.Price * 100);
                        var expired = pkg.ExpiresAt is { } exp && exp < DateTime.Today;
                        <div class="package-card @(pkg.RemainingSessions == 0 || expired ? "opacity-75" : null)">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <strong>@pkg.Name</strong>
                                    <span class="d-block small text-muted-mc">
                                        Comprado em @pkg.PurchasedAt.ToString("dd/MM/yyyy")@(pkg.ExpiresAt is { } e ? $" · válido até {e:dd/MM/yyyy}" : null)@(expired ? " · vencido" : null)
                                    </span>
                                </div>
                                <div class="text-end">
                                    <strong>@pkg.Price.ToString("C")</strong>
                                    <span class="d-block small text-muted-mc">@pkg.PaidAmount.ToString("C") pagos</span>
                                </div>
                            </div>
                            <div class="session-dots my-2" aria-label="@used de @pkg.TotalSessions sessões usadas">
                                @for (var i = 0; i < pkg.TotalSessions; i++)
                                {
                                    <span class="@(i < used ? "used" : null)"></span>
                                }
                                <small class="ms-2 text-muted-mc">@pkg.RemainingSessions de @pkg.TotalSessions restantes</small>
                            </div>
                            <div class="progress progress-thin mb-2" role="progressbar" aria-label="Percentual pago" aria-valuenow="@paidPct" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @paidPct%"></div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @foreach (var entry in pkg.Entries.OrderBy(e => e.PaidAt))
                                {
                                    <span class="badge-soft neutral">
                                        @entry.PaidAt.ToString("dd/MM") · @entry.Amount.ToString("C") · @(entry.Method.DisplayName())
                                        <button class="btn-close btn-close-sm ms-1" type="button" style="font-size:.5rem" aria-label="Remover recebimento"
                                                data-api-action="/Payment/DeleteEntry/@entry.Id" data-method="DELETE" data-confirm="Remover este recebimento do pacote?" data-confirm-text="Remover"></button>
                                    </span>
                                }
                                @if (pkg.PaidAmount < pkg.Price)
                                {
                                    <form class="d-flex gap-1 ms-auto" data-api-form data-method="POST" data-reload action="/Package/Receive/@pkg.Id">
                                        <input class="form-control form-control-sm" style="width: 7rem" name="amount" type="number" min="0.01" step="0.01" max="@((pkg.Price - pkg.PaidAmount).ToString(System.Globalization.CultureInfo.InvariantCulture))" value="@((pkg.Price - pkg.PaidAmount).ToString(System.Globalization.CultureInfo.InvariantCulture))" required aria-label="Valor recebido" />
                                        <select class="form-select form-select-sm w-auto" name="method" aria-label="Forma">
                                            @foreach (var m in Enum.GetValues<PaymentMethod>().Where(m => m != PaymentMethod.Outro))
                                            {
                                                <option value="@m">@(m.DisplayName())</option>
                                            }
                                        </select>
                                        <button class="btn btn-soft btn-sm" type="submit">Receber</button>
                                    </form>
                                }
                                @if (used == 0)
                                {
                                    <button class="btn-icon danger" type="button" title="Excluir pacote"
                                            data-api-action="/Package/Delete/@pkg.Id" data-method="DELETE" data-confirm="Excluir o pacote “@pkg.Name”?" data-confirm-text="Excluir">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ---------------- Documentos ---------------- *@
            <div class="tab-pane fade" id="tab-docs" role="tabpanel">
                @if (!c.IsAnonymized)
                {
                    <form class="mc-card mc-card-body pt-4 mb-3" id="upload-form" autocomplete="off">
                        <input type="hidden" name="clientId" value="@c.Id" />
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label" for="doc-file">Arquivo</label>
                                <input class="form-control" type="file" id="doc-file" name="file" accept=".pdf,.png,.jpg,.jpeg,.docx" required />
                                <small class="text-muted-mc">PDF, imagem ou Word · até @Model.MaxUploadMegabytes MB</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="doc-category">Tipo</label>
                                <select class="form-select" id="doc-category" name="category">
                                    <option value="Administrativo">Administrativo</option>
                                    @if (notes.CanWrite)
                                    {
                                        <option value="Clinico">Clínico (sigiloso)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="doc-description">Descrição</label>
                                <input class="form-control" id="doc-description" name="description" maxlength="200" placeholder="Ex.: termo de consentimento" />
                            </div>
                        </div>
                        <div class="text-end mt-3">
                            <button class="btn btn-primary" type="submit"><i class="bi bi-upload me-1"></i> Anexar</button>
                        </div>
                    </form>
                }

                <div class="mc-card mc-card-body pt-4">
                    @if (Model.Documents.Count == 0)
                    {
                        <div class="empty-state py-3"><i class="bi bi-folder2-open"></i>Nenhum documento anexado.</div>
                    }
                    @foreach (var doc in Model.Documents)
                    {
                        var icon = doc.ContentType switch
                        {
                            "application/pdf" => "bi-file-earmark-pdf",
                            var t when t.StartsWith("image/", StringComparison.Ordinal) => "bi-file-earmark-image",
                            _ => "bi-file-earmark-word",
                        };
                        <div class="agenda-item">
                            <div class="agenda-date"><i class="bi @icon fs-4"></i></div>
                            <div class="flex-grow-1 min-w-0">
                                <a class="fw-semibold text-truncate d-block text-reset" asp-controller="Record" asp-action="Download" asp-route-id="@doc.Id" asp-route-inline="true" target="_blank" rel="noopener">@doc.FileName</a>
                                <small class="text-muted-mc">
                                    @(doc.Description ?? "Sem descrição") · @doc.UploadedAt.ToString("dd/MM/yyyy") · @(doc.SizeBytes < 1024 * 1024 ? $"{doc.SizeBytes / 1024.0:0} KB" : $"{doc.SizeBytes / 1024.0 / 1024.0:0.0} MB")
                                </small>
                            </div>
                            <span class="badge-soft @(doc.Category == DocumentCategory.Clinico ? "danger" : "neutral")">
                                <i class="bi @(doc.Category == DocumentCategory.Clinico ? "bi-shield-lock" : "bi-folder")"></i>@(doc.Category == DocumentCategory.Clinico ? "Clínico" : "Administrativo")
                            </span>
                            <a class="btn-icon" asp-controller="Record" asp-action="Download" asp-route-id="@doc.Id" title="Baixar"><i class="bi bi-download"></i></a>
                            <button class="btn-icon danger" type="button" title="Excluir"
                                    data-api-action="/Record/DeleteDocument/@doc.Id" data-method="DELETE" data-confirm="Excluir o documento “@doc.FileName”?" data-confirm-text="Excluir">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" id="note-edit-form" data-api-form data-method="PUT" data-reload autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title" id="noteModalTitle">Editar evolução</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="clientId" value="@c.Id" />
                <textarea class="form-control" name="content" rows="10" maxlength="20000" required aria-label="Conteúdo"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            // Edição de evolução: reaproveita o formulário do modal.
            const modalEl = document.getElementById('noteModal');
            const editForm = document.getElementById('note-edit-form');
            document.querySelectorAll('[data-note-edit]').forEach(button => button.addEventListener('click', () => {
                editForm.setAttribute('action', `/Record/UpdateNote/${button.dataset.noteEdit}`);
                editForm.content.value = button.dataset.noteContent;
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }));

            // Upload multipart (o helper api() envia JSON).
            const upload = document.getElementById('upload-form');
            upload?.addEventListener('submit', async (event) => {
                event.preventDefault();
                const button = upload.querySelector('[type="submit"]');
                await MindCare.Forms.submit(upload, button, async () => {
                    const response = await fetch('/Record/Upload', {
                        method: 'POST',
                        headers: { 'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content, Accept: 'application/json' },
                        body: new FormData(upload),
                    });
                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok) throw new MindCare.ApiError(payload.message ?? 'Não foi possível anexar o arquivo.', payload.errors);
                    MindCare.Toast.flash(payload.message);
                    window.location.hash = 'documentos';
                    window.location.reload();
                    return payload;
                });
            });

            // Reabre a aba de documentos após anexar.
            if (window.location.hash === '#documentos') {
                bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target="#tab-docs"]')).show();
            }

            // Mantém a aba aberta após ações que recarregam a página.
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => tab.addEventListener('shown.bs.tab', () => {
                try { sessionStorage.setItem('mindcare:client-tab', tab.dataset.bsTarget); } catch { }
            }));
            try {
                const saved = sessionStorage.getItem('mindcare:client-tab');
                const tab = saved && document.querySelector(`[data-bs-target="${saved}"]`);
                if (tab && window.location.hash !== '#documentos') bootstrap.Tab.getOrCreateInstance(tab).show();
            } catch { }
        })();
    </script>
}
