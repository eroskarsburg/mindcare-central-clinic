@model IReadOnlyList<Client>
@{
    ViewData["Title"] = "Pacientes";
    var isAdmin = User.IsAdmin();
}

<section data-crud data-endpoint="/Client" data-modal="#clientModal">
    <header class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-people"></i> Cadastro</span>
            <h1>Pacientes</h1>
            <p>@Model.Count @(Model.Count == 1 ? "paciente cadastrado" : "pacientes cadastrados")</p>
        </div>
        <button class="btn btn-primary" type="button" data-crud-create><i class="bi bi-plus-lg me-1"></i> Novo paciente</button>
    </header>

    <div class="mc-card mc-card-body pt-4">
        <table class="table table-hover" data-table>
            <thead>
                <tr>
                    <th>Paciente</th>
                    <th>CPF</th>
                    <th>Gênero</th>
                    <th>Idade</th>
                    <th>LGPD</th>
                    <th class="no-sort table-actions"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar" style="width:2rem;height:2rem;font-size:.75rem">@c.Name[..1].ToUpperInvariant()</span>
                                <span class="cell-title">@c.Name</span>
                            </div>
                        </td>
                        <td class="font-monospace small">@Cpf.Format(c.Cpf)</td>
                        <td>@c.Gender</td>
                        <td data-order="@(c.Age ?? -1)">@(c.Age?.ToString() ?? "—")</td>
                        <td>
                            @if (c.IsAnonymized)
                            {
                                <span class="badge-soft slate" title="Anonimizado em @c.AnonymizedAt?.ToString("dd/MM/yyyy")"><i class="bi bi-incognito"></i>Anonimizado</span>
                            }
                            else if (c.ConsentAt is not null)
                            {
                                <span class="badge-soft success" title="Termo registrado em @c.ConsentAt?.ToString("dd/MM/yyyy")"><i class="bi bi-file-earmark-check"></i>Termo</span>
                            }
                            else
                            {
                                <span class="badge-soft warning"><i class="bi bi-file-earmark-x"></i>Sem termo</span>
                            }
                        </td>
                        <td class="table-actions">
                            @if (!c.IsAnonymized)
                            {
                                <button class="btn-icon" type="button" title="Editar" aria-label="Editar @c.Name"
                                        data-crud-edit data-item="@Html.ToDataJson(new { c.Id, c.Name, c.Cpf, c.Gender, c.Age, ConsentGiven = c.ConsentAt != null })">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                            @if (isAdmin)
                            {
                                <div class="dropdown d-inline-block">
                                    <button class="btn-icon" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="Mais ações" aria-label="Mais ações para @c.Name">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item" asp-action="Export" asp-route-id="@c.Id"><i class="bi bi-download me-2"></i>Exportar dados (LGPD)</a></li>
                                        @if (!c.IsAnonymized)
                                        {
                                            <li>
                                                <button class="dropdown-item text-danger" type="button"
                                                        data-api-action="/Client/Anonymize/@c.Id" data-method="POST" data-confirm-text="Anonimizar"
                                                        data-confirm="Anonimizar @c.Name? Nome, CPF e observações serão removidos de forma irreversível. O histórico de consultas e pagamentos é mantido sem identificação.">
                                                    <i class="bi bi-incognito me-2"></i>Anonimizar
                                                </button>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button class="dropdown-item text-danger" type="button" data-crud-delete data-id="@c.Id" data-name="@c.Name">
                                                <i class="bi bi-trash3 me-2"></i>Excluir
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <button class="btn-icon danger" type="button" title="Excluir" aria-label="Excluir @c.Name"
                                        data-crud-delete data-id="@c.Id" data-name="@c.Name">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade" id="clientModal" tabindex="-1" aria-labelledby="clientModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title" id="clientModalTitle" data-title-create="Novo paciente" data-title-edit="Editar paciente">Novo paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="client-name">Nome completo</label>
                    <input class="form-control" id="client-name" name="name" maxlength="100" required />
                </div>
                <div class="row g-3">
                    <div class="col-sm-7">
                        <label class="form-label" for="client-cpf">CPF</label>
                        <input class="form-control" id="client-cpf" name="cpf" data-mask="cpf" inputmode="numeric" placeholder="000.000.000-00" required />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label" for="client-age">Idade</label>
                        <input class="form-control" id="client-age" name="age" type="number" min="0" max="130" />
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label" for="client-gender">Gênero</label>
                    <select class="form-select" id="client-gender" name="gender" required>
                        @foreach (var g in Genders.All)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
                <div class="form-check mt-3 p-3 rounded-3" style="background: var(--mc-surface-muted); padding-left: 2.25rem !important">
                    <input class="form-check-input" type="checkbox" id="client-consent" name="consentGiven" />
                    <label class="form-check-label" for="client-consent">
                        Termo de consentimento para tratamento de dados assinado
                        <span class="d-block small text-muted-mc">Exigido pela LGPD para dados de saúde (art. 11).</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>
