@inject IOptions<ClinicOptions> Clinic

<aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menu principal">
    <div class="offcanvas-body">
        <div class="d-flex align-items-start justify-content-between">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-flower1"></i></span>
                <span>
                    <span class="brand-name d-block">@Clinic.Value.Name</span>
                    <span class="brand-tagline">@Clinic.Value.Tagline</span>
                </span>
            </a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Fechar menu"></button>
        </div>

        <nav>
            <div class="nav-section">Atendimento</div>
            <ul class="nav flex-column">
                <li><a class="nav-link @Html.ActiveWhen("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Visão geral</a></li>
                <li><a class="nav-link @Html.ActiveWhen("Appointment")" asp-controller="Appointment" asp-action="Index"><i class="bi bi-calendar-heart"></i> Agenda</a></li>
                <li><a class="nav-link @Html.ActiveWhen("Schedule")" asp-controller="Schedule" asp-action="Index"><i class="bi bi-clock-history"></i> Horários</a></li>
                <li><a class="nav-link @Html.ActiveWhen("Client")" asp-controller="Client" asp-action="Index"><i class="bi bi-people"></i> Pacientes</a></li>
                <li><a class="nav-link @Html.ActiveWhen("Payment")" asp-controller="Payment" asp-action="Index"><i class="bi bi-wallet2"></i> Financeiro</a></li>
            </ul>

            @if (User.IsAdmin())
            {
                <div class="nav-section">Administração</div>
                <ul class="nav flex-column">
                    <li><a class="nav-link @Html.ActiveWhen("Professional")" asp-controller="Professional" asp-action="Index"><i class="bi bi-person-badge"></i> Profissionais</a></li>
                    <li><a class="nav-link @Html.ActiveWhen("User")" asp-controller="User" asp-action="Index"><i class="bi bi-shield-lock"></i> Usuários</a></li>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Messages" ? "active" : null)" asp-controller="Notification" asp-action="Messages"><i class="bi bi-send"></i> Mensagens</a></li>
                    <li><a class="nav-link @Html.ActiveWhen("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-journal-text"></i> Auditoria</a></li>
                </ul>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-1">
                <div class="dropup flex-grow-1">
                    <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@User.GetInitials()</span>
                        <span class="text-truncate">
                            <span class="fw-semibold d-block text-truncate">@User.GetDisplayName()</span>
                            <small>@(User.IsAdmin() ? "Administrador" : "Profissional")</small>
                        </span>
                    </button>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Meu perfil</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sair</button>
                            </form>
                        </li>
                    </ul>
                </div>
                @await Component.InvokeAsync("NotificationBell")
                <button class="btn btn-link theme-toggle fs-5" type="button" data-theme-toggle aria-label="Alternar tema claro/escuro">
                    <i class="bi bi-moon-stars" data-theme-icon></i>
                </button>
            </div>
        </div>
    </div>
</aside>
