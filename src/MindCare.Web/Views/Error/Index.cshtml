@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Bare"] = true;
}

<div class="error-page">
    <div>
        <div class="error-code">@Model.StatusCode</div>
        <h1 class="mt-3">@Model.Title</h1>
        <p class="text-muted-mc mb-4">@Model.Message</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Voltar ao início</a>
        @if (Model.StatusCode >= 500 && !string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small text-muted-mc mt-4 mb-0">Código para suporte: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
