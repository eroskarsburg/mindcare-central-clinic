@model AppointmentsPageViewModel
@{
    ViewData["Title"] = "Agenda";
    var now = DateTime.Now;
    var upcoming = Model.Appointments.Count(a => a.ScheduledAt >= now);
}

<section data-crud data-endpoint="/Appointment" data-modal="#appointmentModal">
    <header class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-calendar-heart"></i> Atendimentos</span>
            <h1>Agenda</h1>
            <p>@upcoming @(upcoming == 1 ? "consulta futura" : "consultas futuras") · @Model.Appointments.Count no total</p>
        </div>
        @if (Model.Clients.Count == 0)
        {
            <a class="btn btn-soft" asp-controller="Client" asp-action="Index"><i class="bi bi-person-plus me-1"></i> Cadastre um paciente primeiro</a>
        }
        else
        {
            <button class="btn btn-primary" type="button" data-crud-create><i class="bi bi-plus-lg me-1"></i> Agendar consulta</button>
        }
    </header>

    <div class="mc-card mc-card-body pt-4">
        <table class="table table-hover" data-table>
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Paciente</th>
                    <th>Modalidade</th>
                    <th>Valor</th>
                    <th>Pagamento</th>
                    <th class="no-sort table-actions"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Appointments)
                {
                    var p = a.Payment ?? new Payment();
                    var past = a.ScheduledAt < now;
                    <tr class="@(past ? "opacity-75" : null)">
                        <td data-order="@a.ScheduledAt.ToString("yyyyMMddHHmm")">
                            <span class="cell-title">@a.ScheduledAt.ToString("dd/MM/yyyy")</span>
                            <span class="cell-sub">@a.ScheduledAt.ToString("ddd · HH:mm")</span>
                        </td>
                        <td>
                            <span class="cell-title">@a.Client?.Name</span>
                            @if (!string.IsNullOrEmpty(a.Observation))
                            {
                                <span class="cell-sub text-truncate" style="max-width: 280px" title="@a.Observation">@a.Observation</span>
                            }
                        </td>
                        <td><span class="badge-soft slate"><i class="bi @a.Modality.ModalityIcon()"></i>@a.Modality</span></td>
                        <td data-order="@p.Price">@p.Price.ToString("C")</td>
                        <td><partial name="_PaymentStatus" model="p.Status" /></td>
                        <td class="table-actions">
                            <button class="btn-icon" type="button" title="Editar" aria-label="Editar consulta"
                                    data-crud-edit data-item="@Html.ToDataJson(new { a.Id, a.ClientId, a.Modality, a.ScheduledAt, a.Observation, p.Price, PaidPrice = p.PaidPrice == 0 ? (decimal?)null : p.PaidPrice })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn-icon danger" type="button" title="Excluir" aria-label="Excluir consulta"
                                    data-crud-delete data-id="@a.Id" data-name="a consulta de @a.Client?.Name em @a.ScheduledAt.ToString("dd/MM 'às' HH:mm")">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentModalTitle" data-title-create="Agendar consulta" data-title-edit="Editar consulta">Agendar consulta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="form-section"><i class="bi bi-calendar-event"></i> Consulta</div>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label" for="appointment-client">Paciente</label>
                        <select class="form-select" id="appointment-client" name="clientId" required>
                            <option value="" selected disabled>Selecione o paciente</option>
                            @foreach (var c in Model.Clients)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="appointment-date">Data e horário</label>
                        <input class="form-control" id="appointment-date" name="scheduledAt" type="datetime-local" step="300" required />
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Modalidade</span>
                        <div class="segmented" role="radiogroup" aria-label="Modalidade">
                            <input class="btn-check" type="radio" name="modality" id="modality-presencial" value="Presencial" checked data-default />
                            <label class="btn" for="modality-presencial"><i class="bi bi-door-open me-1"></i> Presencial</label>
                            <input class="btn-check" type="radio" name="modality" id="modality-tele" value="Teleconsulta" />
                            <label class="btn" for="modality-tele"><i class="bi bi-camera-video me-1"></i> Teleconsulta</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="appointment-observation">Observação <span class="text-muted-mc fw-normal">(opcional)</span></label>
                        <textarea class="form-control" id="appointment-observation" name="observation" rows="2" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="form-section mt-4"><i class="bi bi-wallet2"></i> Pagamento</div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="appointment-price">Valor da consulta</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input class="form-control" id="appointment-price" name="price" type="number" min="0" step="0.01" required />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="appointment-paid">Valor já pago</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input class="form-control" id="appointment-paid" name="paidPrice" type="number" min="0" step="0.01" placeholder="0,00" />
                        </div>
                    </div>
                </div>
                <p class="small text-muted-mc mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>O status do pagamento é calculado automaticamente a partir dos valores.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>
